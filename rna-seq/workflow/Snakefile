###############################################
# Unified RNA-seq workflow entry point.
#
# Recommended launcher:
#   bash run.sh <upstream|deg|as|lncrna> <project_dir> [config.yaml] [jobs]
#
# run.sh injects RNASEQ_PIPELINE and, when supplied, RNASEQ_CONFIG before
# Snakemake parses this file. Direct Snakemake invocation is also supported:
#   RNASEQ_PIPELINE=deg RNASEQ_CONFIG=/path/to/config.yaml \
#     snakemake -s workflow/Snakefile -j 10
###############################################
import os

BASE_DIR = os.path.dirname(workflow.basedir)   # Repository root.
WORKFLOW_DIR = workflow.basedir                # workflow/ directory.

# Load species presets first; explicit top-level project config values win.
configfile: os.path.join(BASE_DIR, "config", "species.yaml")

# Load project config when provided, otherwise use the repository default.
configfile: os.environ.get("RNASEQ_CONFIG", os.path.join(BASE_DIR, "config", "config.yaml"))

# Runtime mode: upstream | deg | as | lncrna.
PIPELINE = (os.environ.get("RNASEQ_PIPELINE") or config.get("pipeline") or "upstream").strip().lower()
if PIPELINE not in ("upstream", "deg", "as", "lncrna"):
    raise ValueError(
        f"Unknown pipeline '{PIPELINE}'. Choose upstream, deg, as, or lncrna."
    )

# Resolve species resources. Explicit top-level values override species presets.
SPECIES = config.get("species", "osa")
if SPECIES not in ("osa", "hsa"):
    raise ValueError(f"Unknown species '{SPECIES}'. Choose osa or hsa.")
for _key, _value in (config.get(SPECIES) or {}).items():
    if _key not in config:
        config[_key] = _value

# Shared definitions and helper functions.
include: os.path.join(WORKFLOW_DIR, "rules", "common.smk")

# Restrict sample wildcards to ids declared in the sample table. This prevents
# paired-end R1/R2 filenames from being misinterpreted as separate SE samples.
wildcard_constraints:
    sample=SAMPLE_WILDCARD

# Final targets selected by pipeline mode.
TARGETS = []
TARGETS += [
    R("multiqc/multiqc_report.html"),
    R("3.align/mapping_stat.xls"),
    R("software_versions.yaml"),
]
TARGETS += [expand(R("3.align/{sample}_Aligned.sortedByCoord.out.bam"), sample=SAMPLES)]

if PIPELINE in ("upstream", "deg", "lncrna"):
    TARGETS += [
        R("4.expression/count.matrix.tsv"),
        R("4.expression/GeneExpression_TPM.xls"),
    ]
if PIPELINE == "lncrna":
    TARGETS += [
        R("4.LncRNA/4.5.Final_lncRNA/final_lncRNA.fa"),
        R("5.expression/lncRNA/GeneExpression_TPM.xls"),
    ]
if PIPELINE == "deg":
    TARGETS += [
        R("5.DEG/flag.log"),
        R("5.DEG/GO_KEGG_enrich/flag.log"),
        R("6.DEGcompare/flag.log"),
    ]
if PIPELINE == "as":
    TARGETS += [R("4.assembly/4.1.Assembly_stringtie/merged.gtf")]
    TARGETS += [expand(R("4.assembly/4.1.Assembly_stringtie/{sample}.gtf"), sample=SAMPLES)]
    TARGETS += [expand(R("4.assembly/4.2.IsoformExpr/{sample}.tab"), sample=SAMPLES)]


rule all:
    input:
        TARGETS


# Rule modules.
include: os.path.join(WORKFLOW_DIR, "rules", "meta.smk")
include: os.path.join(WORKFLOW_DIR, "rules", "align.smk")
include: os.path.join(WORKFLOW_DIR, "rules", "quant.smk")

if PIPELINE == "deg":
    include: os.path.join(WORKFLOW_DIR, "rules", "deg.smk")
if PIPELINE == "as":
    include: os.path.join(WORKFLOW_DIR, "rules", "as.smk")
if PIPELINE == "lncrna":
    include: os.path.join(WORKFLOW_DIR, "rules", "lncrna.smk")
