# ---- Python virtual environments and bytecode ----
.venv/
venv/
__pycache__/
*.py[cod]
*.pyd
*.egg-info/

# ---- Local test scaffolding ----
.testscripts/

# ---- Snakemake runtime metadata ----
.snakemake/
*.snakemake*

# ---- Run logs / markers / temporary files ----
logs/
*.log
*.logs.txt
*.flag
flag.log
*.tmp

# ---- Run outputs and reference directories (numbered-stage convention) ----
0.index/
1.rawdata/
2.cleandata/
3.align/
4.peak/
4.assembly/
4.expression/
4.LncRNA/
4.lncrna/
5.DEG/
5.expression/
5.QC*/
6.DEGcompare/
6.motif/
reference/
results/
temp.*

# ---- High-throughput data files (opt in explicitly with git add -f) ----
*.fastq
*.fastq.gz
*.fq.gz
*.bam
*.bam.bai
*.bai
*.bw
*.bigwig
*.bdg
*.npz

# ---- Test-local artifacts (generated on the fly by tests/make_testdata.py) ----
tests/data/
tests/work/

# ---- Private local config (config.template.yaml + config.local.yaml pattern) ----
config/config.local.yaml
config.local.yaml

# ---- R ----
.Rhistory
.RData
*.Rproj
.Rproj.user/

# ---- Backups / local migration leftovers ----
*.bak
*.bak.*
.local_backup/

# ---- Editors / OS / tooling ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
.glm-conductor/

# Local scratch staging (vendor docs, per-project run configs) — never commit
.tmp_vendor/
