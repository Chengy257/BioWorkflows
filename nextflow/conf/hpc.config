// Shared HPC execution configuration for BioWorkflows Nextflow entries.
//
// Container-only policy on the HPC (design doc D6 / Section 15 amendment 5):
// apptainer is the single supported execution profile. Machine-specific
// paths (executor selection, cache directories) stay in machine-local,
// git-ignored Nextflow configuration (e.g. ~/.nextflow/config) and are
// never recorded here.
//
// Include from an entry with:  includeConfig '../conf/hpc.config'

apptainer {
    enabled = true
}

docker {
    enabled = false
}

process {
    errorStrategy = 'terminate'
    cpus   = 1
    memory = 4.GB
    time   = 4.h
}
