// chipseq-ext - local extension stages for the adopted nf-core/chipseq route.
//
// Every stage is default-off (legacy flag discipline). Enable stages via a
// project params file (-params-file) or CLI --params. The consumed published
// outputs of the adopted nf-core/chipseq run are defined by params.ext_*;
// see README.md for the contract.

includeConfig '../../conf/hpc.config'

params {
    // -- Consumed adopted-run results ---------------------------------------
    ext_results_dir     = null            // REQUIRED: the adopted run's --outdir
    ext_aligner         = 'bwa'
    ext_peak_type       = 'narrow_peak'   // macs3 subdir: narrow_peak | broad_peak
    ext_sample_sheet    = null            // REQUIRED: CSV with sample_id,group,condition,control,batch
    // Optional per-directory overrides; defaults derive from ext_results_dir:
    ext_bam_dir         = null            // default: {results}/{aligner}/filtered_bam
    ext_peaks_dir       = null            // default: {results}/{aligner}/merged_library/macs3/{peak_type}
    ext_consensus_dir   = null            // default: {peaks_dir}/consensus
    ext_bigwig_dir      = null            // default: {results}/{aligner}/bigwig
    ext_flagstat_dir    = null            // default: {results}/{aligner}/flagstat
    ext_bam_suffix      = '.mLb.clN.sorted.bam'
    ext_bigwig_suffix   = '.mLb.clN.bigWig'
    ext_flagstat_suffix = '.mLb.clN.sorted.flagstat'
    ext_dup_glob        = null            // full glob for picard duplicate metrics; null disables dup_rate
    ext_dup_suffix      = '.duplicate_metrics'

    // -- Stage gates (all default-off) --------------------------------------
    organelle_qc {
        enabled = false
        patterns = 'chrc,chrm,pt,mt,pltd,chloroplast,mitochondr,plastid'
    }

    qc_gates {
        enabled                = false
        mapping_rate_min       = 0.70
        dup_rate_max           = 0.50
        organelle_fraction_max = null    // null = informational, no gate
    }

    spike_in {
        enabled         = false           // combined-reference run (host+spike concat index)
        name            = 'spike'
        patterns        = 'spike'         // comma-separated contig-name patterns for spike contigs
        rescale_bigwigs = false
    }

    idr {
        enabled        = false            // narrow-peak IDR on the native per-sample calls
        threshold      = 0.05
        rank           = 'p.value'
        min_replicates = 2
    }

    seacr {
        enabled      = false              // pooled per-group SEACR calls (CUT&Tag/CUT&RUN)
        mode         = 'stringent'        // stringent | relaxed
        normalize    = 'norm'             // norm (with control bedGraph) | non
        fdr_threshold = 0.01              // used for groups without a control
    }

    diffbind {
        enabled         = false
        contrasts       = []              // e.g. ['WT_vs_mut'] (conditionA_vs_conditionB)
        analysis        = 'DESeq2'        // DESeq2 | edgeR
        summit_flank    = 250
        fdr             = 0.05
        foldchange      = 1.0
        batch_correction = true
        use_controls    = false
    }

    homer_motif {
        enabled    = false
        genome     = ''                    // required when enabled: HOMER genome tag (e.g. hg38) or custom FASTA path
        size       = 'given'
        background = ''
        extra      = ''
    }

    outdir = 'results-ext'

    publish_dir_mode = 'copy'
}

process {
    cpus   = 1
    memory = 4.GB
    time   = 2.h

    // IDR: ENCODE-style thresholds from the ratified decision record
    withName: IDR {
        ext.args = "--idr-threshold ${params.idr.threshold} --rank ${params.idr.rank}"
    }
    // SEACR: SEACR_1.3.sh normalization and mode switches; the numeric FDR
    // threshold is passed as the dedicated val input (used without a control)
    withName: SEACR_CALLPEAK {
        ext.args = "${params.seacr.normalize} ${params.seacr.mode}"
    }
    // SEACR consumes raw-depth coverage: unnormalized, bin 1, bedGraph output
    withName: 'DEEPTOOLS_BDGC_RAW|DEEPTOOLS_BDGC_RAW_CTL' {
        ext.args = '--normalizeUsing None --binSize 1 --outFileFormat bedgraph'
    }

    withName: ORGANELLE_SUMMARY {
        publishDir = [path: { "${params.outdir}/organelle_qc" }, mode: params.publish_dir_mode]
    }
    withName: QC_GATES_SUMMARY {
        publishDir = [path: { "${params.outdir}/qc_gates" }, mode: params.publish_dir_mode]
    }
    withName: SPIKEIN_SUMMARY {
        publishDir = [path: { "${params.outdir}/spike_in" }, mode: params.publish_dir_mode]
    }
    withName: SPIKEIN_RESCALE {
        publishDir = [path: { "${params.outdir}/spike_in/bigwigs" }, mode: params.publish_dir_mode]
    }
    withName: IDR_UNION {
        publishDir = [path: { "${params.outdir}/idr/${group}" }, mode: params.publish_dir_mode]
    }
    withName: SEACR_CONVERT {
        publishDir = [path: { "${params.outdir}/seacr" }, mode: params.publish_dir_mode]
    }
    withName: HOMER_FINDMOTIFS {
        publishDir = [path: { "${params.outdir}/homer" }, mode: params.publish_dir_mode]
    }
    withName: RUN_DIFFBIND {
        publishDir = [path: { "${params.outdir}/diffbind/${meta.contrast}" }, mode: params.publish_dir_mode]
    }
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    test_full {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_full.config'
    }
}
