// `test_full` profile: every extension stage ON against the same fixtures
// (dry-run DAG baseline for the enabled-stage scenario; no execution).
params {
    organelle_qc {
        enabled = true
    }
    qc_gates {
        enabled                = true
        organelle_fraction_max = 0.10
    }
    spike_in {
        enabled         = true
        rescale_bigwigs = true
    }
    idr {
        enabled = true
    }
    seacr {
        enabled = true
    }
    diffbind {
        enabled   = true
        contrasts = ['WT_vs_mut']
    }
    homer_motif {
        enabled = true
        // HOMER cannot fetch prebuilt genomes offline; the fixtures ship a
        // tiny custom genome FASTA (generated by tests/make_real_bams.sh)
        genome  = "${projectDir}/tests/fixtures/genome/chr1.fa"
    }
}
