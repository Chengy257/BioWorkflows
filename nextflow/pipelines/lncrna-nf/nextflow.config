// lncrna-nf - BioWorkflows lncRNA identification workflow.
//
// Consumes the Stage-2 rnaseq handoff (published BAMs); no alignment here.
// Every reference is a param (species neutrality): genome/gtf/gtf_pcg plus
// the external homology databases. See README.md for the gtf_pcg build
// recipe and the CPAT model notes.

includeConfig '../../conf/hpc.config'

params {
    // -- Consumed Stage-2 rnaseq handoff --------------------------------------
    bam_dir         = null                  // REQUIRED: {rnaseq_outdir}/{aligner}
    sample_sheet    = null                  // REQUIRED: CSV with a sample_id column
    bam_suffix      = '.markdup.sorted.bam' // markdup BAMs (publish unconditionally); '.sorted.bam' for pre-dedup BAMs (--save_align_intermeds adopted runs)

    // -- References (user-configured; rice shown as the example) --------------
    genome          = null                  // REQUIRED: reference FASTA (sibling .fai must exist)
    gtf             = null                  // REQUIRED: reference annotation GTF
    gtf_pcg         = null                  // REQUIRED: protein-coding CDS GTF (rice: MSU+RAP combined CDS GTF)
    strand          = ''                    // 'rf' | 'fr' | '' - StringTie strandedness (from the Stage-2 strandedness inference); also drives featureCounts -s (rf -> 2, fr -> 1)
    single_end      = false                 // PE/SE for featureCounts (-p); auto-derived when the sheet carries a fastq_2 column

    // -- Identification chain parameters ---------------------------------------
    min_length      = 200                   // legacy length floor (nt)

    cpat {
        enabled     = true                  // D3: CPAT replaces CNCI
        model       = null                  // REQUIRED when enabled: species logit model (human ships with CPAT; rice = user-provided)
        hexamer     = null                  // REQUIRED when enabled: species hexamer table
        extra       = ''
    }

    pfam {
        enabled     = true                  // D4: default ON
        db_dir      = null                  // REQUIRED when enabled: Pfam database directory for pfam_scan.pl
        evalue      = 1e-5                  // legacy threshold
    }

    diamond {
        enabled     = true                  // D4: default ON
        db          = null                  // REQUIRED when enabled: path to nr.dmnd
        extra       = ''
    }

    outdir = 'results-lncrna'

    publish_dir_mode = 'copy'
}

process {
    cpus   = 1
    memory = 4.GB
    time   = 2.h

    // Legacy assembly parameters, ratified in the decision record D2.
    withName: STRINGTIE_STRINGTIE {
        ext.args   = '--conservative -j 5'
        ext.args2  = "${params.strand ? '--' + params.strand : ''}"
    }
    withName: STRINGTIE_MERGE {
        ext.args   = "-F 0.1 -T 0.1"
    }
    // Both alias invocations must emit FASTA (the chain starves otherwise):
    // -w makes the module write <id>.fasta instead of a GFF3 conversion; the
    // module keys its output extension and -o handling off this flag.
    withName: GFFREAD {
        ext.args   = '-w'
    }
    withName: DIAMOND_BLASTX {
        ext.args   = params.diamond.extra
        cpus       = 8
        memory     = 32.GB
        time       = 24.h
    }
    withName: PFAM_SCAN {
        cpus       = 8
        memory     = 24.GB
        time       = 12.h
    }
    withName: SUBREAD_FEATURECOUNTS {
        ext.args   = '-t exon -g gene_id'
    }

    // SDR Section 2 publishes the assembly stage too (per-sample
    // assemblies, the merged novel-transcript set and the gffcompare
    // classcode artifacts; names are unique, so one directory is enough).
    withName: STRINGTIE_STRINGTIE {
        publishDir = [path: { "${params.outdir}/novel" }, mode: params.publish_dir_mode]
    }
    withName: STRINGTIE_MERGE {
        publishDir = [path: { "${params.outdir}/novel" }, mode: params.publish_dir_mode]
    }
    withName: GFFCOMPARE {
        publishDir = [path: { "${params.outdir}/novel" }, mode: params.publish_dir_mode]
    }
    withName: NOVEL_TRANSCRIPTS {
        publishDir = [path: { "${params.outdir}/novel" }, mode: params.publish_dir_mode]
    }
    withName: CPAT_PREDICT {
        publishDir = [path: { "${params.outdir}/coding_predict" }, mode: params.publish_dir_mode]
    }
    withName: CODING_POTENTIAL_SET {
        publishDir = [path: { "${params.outdir}/coding_predict" }, mode: params.publish_dir_mode]
    }
    withName: PFAM_SCAN {
        publishDir = [path: { "${params.outdir}/pfam_search" }, mode: params.publish_dir_mode]
    }
    withName: DIAMOND_BLASTX {
        publishDir = [path: { "${params.outdir}/nr_search" }, mode: params.publish_dir_mode]
    }
    withName: FINAL_LNCRNA_SET {
        publishDir = [path: { "${params.outdir}/final" }, mode: params.publish_dir_mode]
    }
    withName: MERGE_LNCRNA_COUNTS {
        publishDir = [path: { "${params.outdir}/expression" }, mode: params.publish_dir_mode]
    }
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    test_full {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_full.config'
    }
}
