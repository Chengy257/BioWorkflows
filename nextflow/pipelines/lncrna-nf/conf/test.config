// `test` profile: the core identification chain over the synthetic fixtures
// with the homology/database stages OFF (they need external DBs).
// Fixture layout is produced by tests/make_fixtures.py and mirrors the
// Stage-2 rnaseq handoff ({aligner}/ with markdup BAMs).
params {
    bam_dir      = "${projectDir}/tests/fixtures/results/star_salmon"
    sample_sheet = "${projectDir}/tests/fixtures/samplesheet.csv"
    genome       = "${projectDir}/tests/fixtures/reference/genome.fa"
    gtf          = "${projectDir}/tests/fixtures/reference/genes.gtf"
    gtf_pcg      = "${projectDir}/tests/fixtures/reference/genes_pcg.gtf"
    strand       = ''
    single_end   = true                 // fixture BAMs carry single-end reads
    cpat {
        enabled  = true
        model    = "${projectDir}/tests/fixtures/reference/cpat_model.logit"
        hexamer  = "${projectDir}/tests/fixtures/reference/hexamer.tsv"
    }
    pfam {
        enabled  = false
    }
    diamond {
        enabled  = false
    }
    outdir = "${projectDir}/tests/fixtures/results-lncrna"
}
