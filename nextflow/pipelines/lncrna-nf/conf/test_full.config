// `test_full` profile: everything ON - the fixture mini Pfam + DIAMOND
// databases make the homology stages runnable at fixture scale (real
// container execution deferred; owner decision 2026-10-12).
params {
    pfam {
        enabled = true
        db_dir  = "${projectDir}/tests/fixtures/reference/pfam_db"
    }
    diamond {
        enabled = true
        db      = "${projectDir}/tests/fixtures/reference/nr.dmnd"
    }
}
