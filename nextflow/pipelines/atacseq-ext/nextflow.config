// atacseq-ext - local extension stages for the adopted nf-core/atacseq route.
//
// Every stage is default-off (legacy flag discipline). Enable stages via a
// project params file (-params-file) or CLI --params. The consumed published
// outputs of the adopted nf-core/atacseq run are defined by params.ext_*;
// see README.md for the contract.

includeConfig '../../conf/hpc.config'

params {
    // -- Consumed adopted-run results ---------------------------------------
    ext_results_dir     = null            // REQUIRED: the adopted run's --outdir
    ext_aligner         = 'bowtie2'       // the plant route's documented aligner (upstream default is bwa)
    ext_peak_type       = 'broad_peak'    // macs3 subdir: narrow_peak | broad_peak (upstream default broad)
    ext_sample_sheet    = null            // REQUIRED: CSV with sample_id,group,condition,control,batch
    // Optional per-directory overrides; defaults derive from ext_results_dir
    // and mirror the pinned upstream publish layout ({aligner}/merged_library):
    ext_bam_dir         = null            // default: {results}/{aligner}/merged_library
    ext_flagstat_dir    = null            // default: {results}/{aligner}/merged_library/samtools_stats
    ext_consensus_bed   = null            // default: {results}/{aligner}/merged_library/macs3/{peak_type}/consensus/consensus_peaks.mLb.clN.bed
    // The filtered BAMs (+.bai) publish unconditionally on the pinned
    // revision - no --save_align_intermeds caveat here (unlike the chipseq
    // route's PE case):
    ext_bam_suffix      = '.mLb.clN.sorted.bam'
    ext_flagstat_suffix = '.mLb.clN.sorted.bam.flagstat'
    ext_dup_glob        = null            // default: {results}/{aligner}/merged_library/picard_metrics/*.metrics.txt
    ext_dup_suffix      = '.metrics.txt'

    // -- Stage gates (all default-off) --------------------------------------
    organelle_qc {
        enabled = false
        patterns = 'chrc,chrm,pt,mt,pltd,chloroplast,mitochondr,plastid'
    }

    qc_gates {
        enabled                = false
        mapping_rate_min       = 0.70
        dup_rate_max           = 0.50
        organelle_fraction_max = null    // null = informational, no gate
    }

    spike_in {
        enabled         = false           // combined-reference run (host+spike concat index)
        name            = 'spike'
        patterns        = 'spike'         // comma-separated contig-name patterns for spike contigs
        rescale_bigwigs = false
    }

    footprint {
        enabled             = false        // per-group pooled TOBIAS chain (BINDetect needs >= 2 groups)
        genome              = ''           // required when enabled: reference FASTA (sibling .fai must exist)
        motifs              = ''           // required when enabled: JASPAR PFM motif file
        motif_pvalue        = 1e-4
        skip_control_groups = true         // skip groups whose treats are all declared controls (shared-IgG groups)
    }

    outdir = 'results-ext'

    publish_dir_mode = 'copy'
}

process {
    cpus   = 1
    memory = 4.GB
    time   = 2.h

    // BINDetect: skip the xlsx export (openpyxl-free legacy behavior) and
    // pass the motif p-value from params.
    withName: TOBIAS_BINDETECT {
        ext.args = "--skip-excel --motif-pvalue ${params.footprint.motif_pvalue}"
        cpus   = 4
        memory = 16.GB
        time   = 8.h
    }
    withName: TOBIAS_ATACORRECT {
        cpus   = 4
        memory = 16.GB
        time   = 8.h
    }

    withName: ORGANELLE_SUMMARY {
        publishDir = [path: { "${params.outdir}/organelle_qc" }, mode: params.publish_dir_mode]
    }
    withName: QC_GATES_SUMMARY {
        publishDir = [path: { "${params.outdir}/qc_gates" }, mode: params.publish_dir_mode]
    }
    withName: SPIKEIN_SUMMARY {
        publishDir = [path: { "${params.outdir}/spike_in" }, mode: params.publish_dir_mode]
    }
    withName: SPIKEIN_RESCALE {
        publishDir = [path: { "${params.outdir}/spike_in/bigwigs" }, mode: params.publish_dir_mode]
    }
    withName: TOBIAS_ATACORRECT {
        publishDir = [path: { "${params.outdir}/footprint/${meta.id}/atacorrect" }, mode: params.publish_dir_mode]
    }
    withName: TOBIAS_SCOREBIGWIG {
        publishDir = [path: { "${params.outdir}/footprint/${meta.id}/scorebigwig" }, mode: params.publish_dir_mode]
    }
    withName: TOBIAS_BINDETECT {
        publishDir = [path: { "${params.outdir}/footprint/bindetect" }, mode: params.publish_dir_mode]
    }
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    test_full {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_full.config'
    }
}
