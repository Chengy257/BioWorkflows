// `test_full` profile: every ext stage ON over the synthetic fixtures.
// Dry-run baseline (recorded in the validation notes): 22 tasks over
// 9 processes - SAMTOOLS_IDXSTATS x4 (organelle) + ORGANELLE_SUMMARY +
// QC_GATES_SUMMARY + SAMTOOLS_IDXSTATS x4 (spike-in) + SPIKEIN_SUMMARY +
// SPIKEIN_RESCALE x4 + TOBIAS_MERGE_GROUPS x2 + TOBIAS_ATACCORRECT x2 +
// TOBIAS_SCOREBIGWIG x2 + TOBIAS_BINDETECT.
params {
    organelle_qc.enabled = true
    qc_gates.enabled     = true
    spike_in {
        enabled         = true
        rescale_bigwigs = true
    }
    footprint {
        enabled = true
        genome  = "${projectDir}/tests/fixtures/reference/genome.fa"
        motifs  = "${projectDir}/tests/fixtures/reference/motifs.jaspar"
    }
}
