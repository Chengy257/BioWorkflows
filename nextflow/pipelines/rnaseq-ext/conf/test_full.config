// `test_full` profile: every ratified extension stage ON against the same
// fixtures (dry-run DAG baseline for the enabled-stage scenario; no
// execution). The quantification route switch is exercised on the
// featurecounts side (the salmon-side route is the `test` default).
params {
    quantification_route = 'featurecounts'
    ext_gtf              = "${projectDir}/tests/fixtures/reference/genes.gtf"
    ext_gene_bed         = "${projectDir}/tests/fixtures/reference/genes.bed"

    featurecounts_quant {
        enabled = true
        strand  = 'auto'
    }

    enrichment {
        enabled       = true
        de_dir        = "${projectDir}/tests/fixtures/da_out/tables/differential"
        orgdb         = 'org.Test.eg.db'   // fixture name; no real OrgDb is used in dry-runs
        kegg_organism = ''
    }
}
