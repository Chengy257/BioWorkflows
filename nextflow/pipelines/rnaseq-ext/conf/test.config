// `test` profile: dry-run baseline with all stages OFF (input-resolution
// only). Fixture layout is produced by tests/make_fixtures.py and mirrors
// the pinned nf-core/rnaseq 3.27.0 publish layout ({aligner}/, salmon/).
params {
    ext_results_dir  = "${projectDir}/tests/fixtures/results"
    ext_sample_sheet = "${projectDir}/tests/fixtures/samplesheet.csv"
    ext_metadata     = "${projectDir}/tests/fixtures/metadata.csv"
    outdir           = "${projectDir}/tests/fixtures/results-ext"
}
