// rnaseq-ext - local extension stages for the adopted nf-core/rnaseq route.
//
// Every stage is default-off (legacy flag discipline). Enable stages via a
// project params file (-params-file) or CLI --params. The consumed published
// outputs of the adopted nf-core/rnaseq run are defined by params.ext_*;
// see README.md for the contract. Standing owner principles (decision
// record Section 8): the pipeline never binds a species, and nothing is
// silently hardcoded - every knob below is overridable per project.

includeConfig '../../conf/hpc.config'

params {
    // -- Consumed adopted-run results ---------------------------------------
    // Defaults mirror the pinned nf-core/rnaseq 3.27.0 publish layout
    // (conf/modules/*.config): the markdup BAMs publish unconditionally to
    // {outdir}/{aligner}/, the merged Salmon matrix to {outdir}/salmon/.
    ext_results_dir     = null            // REQUIRED: the adopted run's --outdir
    ext_aligner         = 'star_salmon'
    ext_sample_sheet    = null            // REQUIRED: the adopted run's sample sheet (sample,fastq_1,...)
    ext_metadata        = null            // REQUIRED: CSV sample,group[,batch] (analysis metadata; DA adapter + enrichment)
    ext_bam_dir         = null            // default: {results}/{aligner}
    // Markdup BAMs are the default counting input (duplicates removed). Set
    // '.sorted.bam' (with --save_align_intermeds on the adopted run) to
    // reproduce the legacy pre-dedup counting semantics:
    ext_bam_suffix      = '.markdup.sorted.bam'
    ext_salmon_dir      = null            // default: {results}/salmon
    ext_salmon_matrix   = 'salmon.merged.gene_counts.tsv'
    ext_gtf             = ''              // REQUIRED for the featureCounts route (same GTF the adopted run used)
    ext_gene_bed        = ''              // REQUIRED for strand=auto (RSeQC infer_experiment reference BED)

    // -- Quantification route switch (decision record D1) --------------------
    // 'salmon'      = the adopted run's native Salmon matrix is authoritative
    //                 (the featureCounts stage may still run alongside)
    // 'featurecounts' = the ext featureCounts stage runs and its matrix is
    //                 authoritative (implies the stage; ext_gtf required)
    quantification_route = 'salmon'

    // -- Stage gates (all default-off) ---------------------------------------
    featurecounts_quant {
        enabled    = false                 // explicit gate; route=featurecounts forces it on
        strand     = 'auto'                // 'auto' (RSeQC infer_experiment) | '0' | '1' | '2'
        paired     = false                 // -p for paired-end counting (BAM-level; legacy auto-detected from raw reads)
        extra      = ''                    // extra featureCounts arguments appended verbatim
    }

    enrichment {
        enabled      = false
        de_dir       = ''                  // REQUIRED: differentialabundance outdir .../tables/differential
        de_suffix    = '.deseq2.results.tsv'
        orgdb        = ''                  // REQUIRED: OrgDb R package name (e.g. org.Osativa.eg.db) - no species binding
        orgdb_file   = ''                  // optional: OrgDb package tarball staged into the task (container route)
        keytype      = 'GID'               // clusterProfiler keyType for the gene ids in the DE tables
        kegg_organism = ''                 // KEGG code (e.g. dosa/hsa); empty skips KEGG
        padj_max     = 0.05                // DEG cutoff (legacy padj)
        log2fc_min   = 1.0                 // |log2FC| cutoff (legacy FoldChange 2)
        id_col       = 'gene_id'           // gene id column in the DA results tables
        log2fc_col   = 'log2FoldChange'
        padj_col     = 'padj'
        stat_col     = 'stat'              // GSEA ranking column (falls back to log2fc_col)
    }

    outdir = 'results-ext'

    publish_dir_mode = 'copy'
}

process {
    cpus   = 1
    memory = 4.GB
    time   = 2.h

    withName: PARSE_STRANDEDNESS {
        publishDir = [path: { "${params.outdir}/featurecounts_quant/strandedness" }, mode: params.publish_dir_mode]
    }
    // featureCounts counting: strandedness (forward/reverse/unstranded) and
    // single_end ride the meta (set in the workflow layer); the module
    // derives -s/-p itself as the single source of truth. NEVER inject a
    // second -s here: getopt last-wins would silently count every stranded
    // project as unstranded.
    withName: 'SUBREAD_FEATURECOUNTS' {
        ext.args = { params.featurecounts_quant.extra ?: '' }
    }
    withName: MERGE_FEATURECOUNTS {
        publishDir = [path: { "${params.outdir}/featurecounts_quant" }, mode: params.publish_dir_mode]
    }
    withName: RUN_ENRICHMENT {
        publishDir = [path: { "${params.outdir}/enrichment/${meta.contrast}/${meta.direction}" }, mode: params.publish_dir_mode]
    }
    withName: RUN_GSEA {
        publishDir = [path: { "${params.outdir}/enrichment/${meta.contrast}/gsea" }, mode: params.publish_dir_mode]
    }
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    test_full {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_full.config'
    }
}
