# =====================================================================
# chip_cuttag_atac_faire — unified workflow entry point.
#
# ChIP-seq / CUT&Tag / ATAC-seq / FAIRE-seq in one Snakemake workflow;
# rules are routed automatically from the seqtype column of samples.csv
# (mixed-assay projects are supported).
#
# Recommended launcher (full options: run.sh --help):
#   bash run.sh -P /path/to/workdir -c config.yaml --profile pbs
# Direct Snakemake invocation also works:
#   CHIP_CONFIG=/path/to/config.yaml snakemake -s workflow/Snakefile -j 10
# See README.md.
# =====================================================================
import os

BASE_DIR = os.path.dirname(workflow.basedir)   # Repository root
WORKFLOW_DIR = workflow.basedir                # workflow/ directory

# Per-rule scheduler resources are managed in a dedicated file so analysis
# config and cluster resources stay separately editable (run.sh injects
# CHIP_RESOURCES_CONFIG when the project directory carries its own copy).
configfile: os.environ.get("CHIP_RESOURCES_CONFIG", os.path.join(BASE_DIR, "config", "resources.yaml"))

# CHIP_CONFIG is injected by run.sh for the project-level config; falls back
# to the repository default.
configfile: os.environ.get("CHIP_CONFIG", os.path.join(BASE_DIR, "config", "config.yaml"))

# Resolve species presets first (config/species.yaml): explicit top-level
# project config values win, unset keys fall back to the preset.
SPECIES = config.get("species", "osa")
if SPECIES not in ("osa", "hsa"):
    raise ValueError(f"Unknown species '{SPECIES}'. Choose osa or hsa.")
for _key, _value in (config.get(SPECIES) or {}).items():
    if _key not in config:
        config[_key] = _value

# All shells run under bash -eo pipefail: any failing step aborts immediately
# and pipeline errors are propagated. No set -u: cluster submission and tool
# wrappers may fail on unbound variables under -u, so keep it conservative.
shell.executable("/bin/bash")
shell.prefix("set -eo pipefail; ")

# ---------------------------------------------------------------------
# Shared definitions: sample-table parsing, config validation, rule
# query helpers, and target aggregation
# ---------------------------------------------------------------------
include: os.path.join(WORKFLOW_DIR, "rules", "common.smk")


rule all:
    input:
        QC_TARGETS,
        BAM_TARGETS,
        PEAK_TARGETS,
        BW_TARGETS,
        REPLICATE_TARGETS,
        BLACKLIST_TARGETS,
        TSS_TARGETS,
        ORGANELLE_TARGETS,
        R("4.peak/anno_result/Peakanno_PeakDistributions.pdf"),
        VERSION_TARGETS,


# ---------------------------------------------------------------------
# Rule modules
# ---------------------------------------------------------------------
include: os.path.join(WORKFLOW_DIR, "rules", "upstream.smk")
include: os.path.join(WORKFLOW_DIR, "rules", "dedup.smk")
include: os.path.join(WORKFLOW_DIR, "rules", "callpeak.smk")
if REPLICATE["enabled"]:
    include: os.path.join(WORKFLOW_DIR, "rules", "callpeak_replicate.smk")
include: os.path.join(WORKFLOW_DIR, "rules", "annotation.smk")
if BLACKLIST:
    include: os.path.join(WORKFLOW_DIR, "rules", "blacklist.smk")
if config["qc"]["nsc_rsc"]:
    include: os.path.join(WORKFLOW_DIR, "rules", "spp_qc.smk")
if config["qc"]["frip"]:
    include: os.path.join(WORKFLOW_DIR, "rules", "frip.smk")
if config["qc"]["deeptools"]:
    include: os.path.join(WORKFLOW_DIR, "rules", "qc_deeptools.smk")
if QC_TSS and TSS_SAMPLES:
    include: os.path.join(WORKFLOW_DIR, "rules", "tss_qc.smk")
if QC_ORGANELLE:
    include: os.path.join(WORKFLOW_DIR, "rules", "organelle_qc.smk")

# Run metadata (software-version record), placed after all modules
include: os.path.join(WORKFLOW_DIR, "rules", "meta.smk")
