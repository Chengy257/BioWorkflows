# ---- Snakemake runtime ----
.snakemake/
logs/
*.log

# ---- Analysis output directories (data never belongs in the repository; it is
#      only generated inside the run directory; derived outputs now live under
#      results/ inside each project working directory) ----
0.index/
1.rawdata/
2.cleandata/
3.align/
4.peak/
5.QC*/
6.motif/
reference/

# High-throughput data files (kept out of the repository even if they end up at
# the repository root)
*.fastq
*.fastq.gz
*.fq.gz
*.bam
*.bam.bai
*.bai
*.bw
*.bigwig
*.bdg
*.npz

# ---- Local private configs (config.template.yaml + config.local.yaml pattern) ----
config/config.local.yaml

# ---- R ----
.Rhistory
.RData
*.Rproj
*.Rproj.user/

# ---- Python ----
__pycache__/
*.py[cod]

# ---- System and editor files ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
.glm-conductor/
.venv

# ---- Local test artifacts (generated on demand by tests/make_testdata.py) ----
tests/data/
tests/work/
