# Unified line endings: all scripts in this repository run on Linux
# (HPC/SGE/SLURM), so the working tree must stay LF everywhere.

* text=auto

# Scripts and workflow files: enforce LF
*.sh         text eol=lf
*.smk        text eol=lf
*.py         text eol=lf
*.R          text eol=lf
*.r          text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.csv        text eol=lf
*.tsv        text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.svg        text eol=lf
*.json       text eol=lf
*.Makefile   text eol=lf
Makefile     text eol=lf
.editorconfig text eol=lf
.gitignore   text eol=lf

# Binary files: no conversion
*.png  binary
*.jpg  binary
*.pdf  binary
*.gz   binary
*.bam  binary
*.bai  binary
*.fa   binary
*.fq.gz binary
*.npz  binary
