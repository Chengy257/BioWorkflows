# =====================================================================
# bs-seq — bisulfite sequencing (BS-seq) methylation workflow.
#
# Trim Galore adapter/quality trimming (optional) -> bisulfite genome
# preparation -> Bismark alignment (bowtie2 backend) ->
# deduplicate_bismark -> bismark_methylation_extractor (+ optional
# coverage2cytosine merge_CpG per sample) -> bismark2summary and MultiQC.
#
# Recommended launcher (full options: run.sh --help):
#   bash run.sh -P /path/to/workdir -c config.yaml --profile pbs
# Direct Snakemake invocation also works:
#   BSSEQ_CONFIG=/path/to/config.yaml snakemake -s workflow/Snakefile -j 10
# =====================================================================
import os

BASE_DIR = os.path.dirname(workflow.basedir)   # Repository root
WORKFLOW_DIR = workflow.basedir                # workflow/ directory

# Species presets first; explicit top-level project config values win.
configfile: os.path.join(BASE_DIR, "config", "species.yaml")

# Per-rule scheduler resources (run.sh injects BSSEQ_RESOURCES_CONFIG when
# the project directory carries its own copy).
configfile: os.environ.get("BSSEQ_RESOURCES_CONFIG", os.path.join(BASE_DIR, "config", "resources.yaml"))

# Project config when provided, otherwise the repository default.
configfile: os.environ.get("BSSEQ_CONFIG", os.path.join(BASE_DIR, "config", "config.yaml"))

# Optional last layer: config.local.yaml in the project directory.
_EXTRA_CONFIG = os.environ.get("BSSEQ_EXTRA_CONFIG")
if _EXTRA_CONFIG and os.path.exists(_EXTRA_CONFIG):
    configfile: _EXTRA_CONFIG

# Resolve species presets: every preset key not set by the project config
# is filled in (an unset genome fasta inherits the preset path this way);
# species "none" skips the preset merge entirely.
SPECIES = config.get("species", "osa")
if SPECIES not in ("osa", "hsa", "none"):
    raise ValueError(f"Unknown species '{SPECIES}'. Choose osa, hsa, or none.")
if SPECIES != "none":
    for _key, _value in (config.get(SPECIES) or {}).items():
        if _key not in config:
            config[_key] = _value

# Shared definitions: sample-table parsing, config validation, PE/SE
# helpers, and target aggregation. Included first by every rules/*.smk.
include: os.path.join(WORKFLOW_DIR, "rules", "common.smk")

# Restrict sample wildcards to ids declared in the sample table.
wildcard_constraints:
    sample=SAMPLE_WILDCARD

# Final targets.
rule all:
    input:
        TARGETS

# Rule modules.
include: os.path.join(WORKFLOW_DIR, "rules", "index.smk")
include: os.path.join(WORKFLOW_DIR, "rules", "upstream.smk")
include: os.path.join(WORKFLOW_DIR, "rules", "align.smk")
include: os.path.join(WORKFLOW_DIR, "rules", "methylation.smk")
include: os.path.join(WORKFLOW_DIR, "rules", "meta.smk")
